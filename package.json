{
  "name": "picbase",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A modern file hosting solution powered by Cloudflare",
  "author": "PicBase",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "frontend:install": "npm install --prefix frontend --no-fund --no-audit --progress=false",
    "dev": "npm --prefix frontend run dev",
    "build": "npm run frontend:install && npm --prefix frontend run build",
    "build:fast": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "node --test tests/*.test.mjs",
    "start": "npx wrangler pages dev ./frontend-dist --kv \"img_url\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data",
    "start:local": "npx wrangler pages dev ./frontend-dist --kv \"img_url\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data --local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.726.1",
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@sentry/tracing": "^7.114.0",
    "miniflare": "^4.20260706.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "wrangler": "^4.107.1"
  }
}
